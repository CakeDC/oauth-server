{
    "name": "cakedc/oauth-server",
    "description": "OAuth 2.1 authorization server for PHP: PSR-15 handlers, Client ID Metadata Documents, dynamic registration and resource indicators. Ready for MCP servers.",
    "type": "library",
    "license": "MIT",
    "keywords": ["oauth", "oauth2", "oauth-2.1", "authorization-server", "pkce", "psr-15", "mcp"],
    "authors": [
        {"name": "Cake Development Corporation", "homepage": "https://www.cakedc.com"}
    ],
    "require": {
        "php": ">=8.2",
        "psr/clock": "^1.0",
        "psr/event-dispatcher": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "psr/log": "^2.0 || ^3.0",
        "psr/simple-cache": "^2.0 || ^3.0"
    },
    "require-dev": {
        "cakephp/cakephp-codesniffer": "^5.1",
        "mcp/sdk": "dev-main#82e19d114e95671e05e7df7909195f7ace03d90e as 0.9.0",
        "nyholm/psr7": "^1.8",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5.5 || ^11.1.3 || ^12.1 || ^13.0"
    },
    "suggest": {
        "ext-curl": "Fetches Client ID Metadata Documents",
        "ext-pdo": "Stores clients, codes, tokens and consents with PdoStorage",
        "mcp/sdk": "Bridge\\McpSdk\\TokenValidator plugs the server into the official MCP PHP SDK"
    },
    "autoload": {
        "psr-4": {"CakeDC\\OAuth\\Server\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {"CakeDC\\OAuth\\Server\\Test\\": "tests/"}
    },
    "scripts": {
        "test": "phpunit",
        "cs-check": "phpcs --colors -p",
        "cs-fix": "phpcbf --colors -p",
        "stan": "phpstan analyse --no-progress",
        "check": ["@test", "@cs-check", "@stan"]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "php-http/discovery": false
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
