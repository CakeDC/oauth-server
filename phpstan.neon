parameters:
    level: 8
    paths:
        - src/
    ignoreErrors:
        # Read by the connections handler factory of Task 21; remove this entry then.
        -
            identifier: property.onlyWritten
            message: '#AuthorizationServer::\$connectionsRenderer is never read#'
            path: src/AuthorizationServer.php
        # Only tests use the trait until the JSON handlers (Tasks 19-20) do; PHPStan scans src/ only.
        -
            identifier: trait.unused
            path: src/Http/Handler/GuardsErrors.php
